# Blockscout backend -> potato-chain node0 over the shared docker network
ETHEREUM_JSONRPC_VARIANT=geth
ETHEREUM_JSONRPC_HTTP_URL=http://node0:8545/
ETHEREUM_JSONRPC_TRACE_URL=http://node0:8545/
ETHEREUM_JSONRPC_WS_URL=ws://node0:8546/
ETHEREUM_JSONRPC_TRANSPORT=http
CHAIN_ID=707070
COIN=POTATO
COIN_NAME=Potato
PORT=4000
# 9.0.x uses ECTO_USE_SSL (defaults to true); newer releases use ECTO_SSL_MODE
ECTO_USE_SSL=false
POOL_SIZE=20
POOL_SIZE_API=5
ACCOUNT_REDIS_URL=redis://redis:6379
DISABLE_FILE_LOGGING=true
DISABLE_MARKET=true
RE_CAPTCHA_DISABLED=true
ACCOUNT_ENABLED=false
ADMIN_PANEL_ENABLED=false
# microservices we don't run
MICROSERVICE_SC_VERIFIER_ENABLED=false
MICROSERVICE_VISUALIZE_SOL2UML_ENABLED=false
MICROSERVICE_SIG_PROVIDER_ENABLED=false
NFT_MEDIA_HANDLER_ENABLED=false
# no public mempool view on a BFT chain with app-side mempool
INDEXER_DISABLE_PENDING_TRANSACTIONS_FETCHER=true
